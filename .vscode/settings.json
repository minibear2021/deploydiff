{
    "deploydiff.sftp.host": "example.com",
    "deploydiff.sftp.port": 2222,
    "deploydiff.sftp.username": "deploy",
    "deploydiff.sftp.privateKeyPath": "",
    "deploydiff.mappings": [
        {
            "name": "deploydiff",
            "localPath": "src",
            "remotePath": "/tmp/src",
        }
    ],
    "deploydiff.confirmSync": true,
    "deploydiff.transport": "sftp",
    "deploydiff.mockRemoteFiles": {
        "/var/www/app/src/example.ts": "remote-content",
        "/var/www/app/src/features/one.ts": "one",
        "/var/www/app/src/features/two.ts": "two"
    },
    "deploydiff.ftp.host": "ftp.example.com",
    "deploydiff.ftp.port": 2121,
    "deploydiff.ftp.username": "deploy",
    "deploydiff.ftp.secure": true,
    "deploydiff.ftp.securityMode": "implicit",
    "deploydiff.ftp.passiveModeStrategy": "ignorePasvAddress",
    "deploydiff.ftp.timeoutMs": 15000
}