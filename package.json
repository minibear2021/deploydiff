{
  "name": "deploydiff",
  "displayName": "DeployDiff",
  "description": "Compare local files with deployed remote versions and sync changes in either direction.",
  "version": "0.1.8",
  "publisher": "minibear2021",
  "license": "MIT",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/minibear2021/deploydiff.git"
  },
  "homepage": "https://github.com/minibear2021/deploydiff",
  "bugs": {
    "url": "https://github.com/minibear2021/deploydiff/issues"
  },
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Other",
    "SCM Providers"
  ],
  "keywords": [
    "deployment",
    "diff",
    "sftp",
    "remote",
    "sync",
    "compare"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "deploydiff-sidebar",
          "title": "DeployDiff",
          "icon": "media/sidebar_icon.svg"
        }
      ]
    },
    "views": {
      "deploydiff-sidebar": [
        {
          "id": "deploydiff.diffSessions",
          "name": "Diff Sessions"
        }
      ]
    },
    "commands": [
      {
        "command": "deploydiff.compareWithDeployedVersion",
        "title": "Compare with Deployed Version",
        "category": "DeployDiff"
      },
      {
        "command": "deploydiff.uploadToRemote",
        "title": "Upload to Remote",
        "category": "DeployDiff"
      },
      {
        "command": "deploydiff.downloadFromRemote",
        "title": "Download from Remote",
        "category": "DeployDiff"
      },
      {
        "command": "deploydiff.showOutput",
        "title": "Show Output Logs",
        "category": "DeployDiff"
      },
      {
        "command": "deploydiff.setFtpPassword",
        "title": "Set FTP Password",
        "category": "DeployDiff"
      },
      {
        "command": "deploydiff.clearFtpPassword",
        "title": "Clear FTP Password",
        "category": "DeployDiff"
      },
      {
        "command": "deploydiff.setSftpPassword",
        "title": "Set SFTP Password",
        "category": "DeployDiff"
      },
      {
        "command": "deploydiff.clearSftpPassword",
        "title": "Clear SFTP Password",
        "category": "DeployDiff"
      },
      {
        "command": "deploydiff.openDiffSession",
        "title": "Open Diff Session",
        "category": "DeployDiff"
      },
      {
        "command": "deploydiff.saveAllDiffSessions",
        "title": "Save All",
        "category": "DeployDiff",
        "icon": "$(save-all)"
      },
      {
        "command": "deploydiff.removeDiffSession",
        "title": "Remove",
        "category": "DeployDiff"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "deploydiff.saveAllDiffSessions",
          "when": "view == deploydiff.diffSessions",
          "group": "navigation@1"
        }
      ],
      "view/item/context": [
        {
          "command": "deploydiff.removeDiffSession",
          "when": "view == deploydiff.diffSessions && viewItem == diffSession",
          "group": "inline@1"
        }
      ],
      "explorer/context": [
        {
          "command": "deploydiff.compareWithDeployedVersion",
          "when": "resourceScheme == file",
          "group": "navigation@20"
        },
        {
          "command": "deploydiff.uploadToRemote",
          "when": "resourceScheme == file",
          "group": "navigation@21"
        },
        {
          "command": "deploydiff.downloadFromRemote",
          "when": "resourceScheme == file",
          "group": "navigation@22"
        }
      ],
      "editor/context": [
        {
          "command": "deploydiff.compareWithDeployedVersion",
          "when": "resourceScheme == file || resourceScheme == deploydiff-remote",
          "group": "navigation@20"
        },
        {
          "command": "deploydiff.uploadToRemote",
          "when": "resourceScheme == file || resourceScheme == deploydiff-remote",
          "group": "navigation@21"
        },
        {
          "command": "deploydiff.downloadFromRemote",
          "when": "resourceScheme == file || resourceScheme == deploydiff-remote",
          "group": "navigation@22"
        }
      ]
    },
    "configuration": {
      "title": "DeployDiff",
      "properties": {
        "deploydiff.transport": {
          "type": "string",
          "enum": [
            "ftp",
            "sftp"
          ],
          "scope": "resource",
          "description": "Required. Remote transport implementation used by DeployDiff."
        },
        "deploydiff.confirmSync": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "description": "Ask for confirmation before overwriting the local or remote copy during sync."
        },
        "deploydiff.mappings": {
          "type": "array",
          "default": [],
          "scope": "resource",
          "markdownDescription": "Maps local workspace paths to deployed remote roots.",
          "items": {
            "type": "object",
            "required": [
              "name",
              "localPath",
              "remotePath"
            ],
            "properties": {
              "name": {
                "type": "string",
                "description": "Friendly mapping name."
              },
              "localPath": {
                "type": "string",
                "description": "Workspace-relative local directory root, for example src or packages/app/src."
              },
              "remotePath": {
                "type": "string",
                "description": "Absolute POSIX-style deployed directory, for example /var/www/app/src."
              }
            }
          }
        },
        "deploydiff.ftp.host": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "description": "FTP host name or IP address."
        },
        "deploydiff.ftp.port": {
          "type": "number",
          "default": 21,
          "scope": "resource",
          "description": "FTP port."
        },
        "deploydiff.ftp.username": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "description": "FTP username."
        },
        "deploydiff.ftp.secure": {
          "type": "boolean",
          "default": false,
          "scope": "resource",
          "markdownDeprecationMessage": "Use `deploydiff.ftp.securityMode` instead.",
          "description": "Deprecated. Use FTPS (TLS) when connecting over FTP."
        },
        "deploydiff.ftp.securityMode": {
          "type": "string",
          "enum": [
            "off",
            "explicit",
            "implicit"
          ],
          "default": "off",
          "scope": "resource",
          "description": "FTP security mode: plain FTP, explicit FTPS, or legacy implicit FTPS."
        },
        "deploydiff.ftp.passiveModeStrategy": {
          "type": "string",
          "enum": [
            "default",
            "ignorePasvAddress"
          ],
          "default": "default",
          "scope": "resource",
          "description": "Passive mode strategy. Use ignorePasvAddress for servers behind NAT that return an unusable PASV address."
        },
        "deploydiff.ftp.timeoutMs": {
          "type": "number",
          "default": 10000,
          "scope": "resource",
          "description": "FTP connection and operation timeout in milliseconds. Use 0 to disable the timeout."
        },
        "deploydiff.sftp.host": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "description": "SFTP host name or IP address."
        },
        "deploydiff.sftp.port": {
          "type": "number",
          "default": 22,
          "scope": "resource",
          "description": "SFTP port."
        },
        "deploydiff.sftp.username": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "description": "SFTP username."
        },
        "deploydiff.sftp.privateKeyPath": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "description": "Optional absolute path to a private key file for SFTP authentication."
        }
      }
    }
  },
  "scripts": {
    "build": "tsc -p ./ && npm run bundle",
    "bundle": "node ./scripts/bundle.mjs",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src --ext ts",
    "pretest": "npm run build && npm run lint",
    "test": "node ./out/test/runTest.js",
    "package": "vsce package"
  },
  "dependencies": {
    "basic-ftp": "^5.2.2",
    "diff": "^8.0.4",
    "ssh2-sftp-client": "^12.1.1"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.0.0",
    "@types/ssh2-sftp-client": "^9.0.6",
    "@types/vscode": "^1.100.0",
    "@typescript-eslint/eslint-plugin": "^8.30.1",
    "@typescript-eslint/parser": "^8.30.1",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.6.0",
    "esbuild": "^0.25.3",
    "eslint": "^9.25.1",
    "glob": "^11.0.2",
    "globals": "^16.0.0",
    "mocha": "^11.1.0",
    "typescript": "^5.8.3"
  }
}
